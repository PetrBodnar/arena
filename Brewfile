# Brewfile — все инструменты проекта одной командой: make tools
# (под капотом: brew bundle --file=Brewfile)

cask "orbstack"          # Docker-движок для Mac. Уже стоит не через brew — закомментируйте строку

brew "k3d"               # кластер k3s в контейнерах
brew "kubernetes-cli"    # kubectl
brew "helm"              # установка сторонних чартов (Helm 4)
brew "k9s"               # терминальный UI для кластера
brew "kubectx"           # быстрое переключение контекстов и namespace
brew "argocd"            # CLI Argo CD (M4)
brew "cosign"            # подпись образов (M2)
brew "syft"              # SBOM (M2)
brew "trivy"             # сканер уязвимостей (M1–M2)
brew "opentofu"          # IaC (M6)
brew "ansible"           # настройка VM (M6)
brew "gh"                # GitHub CLI
brew "uv"                # Python-окружение сервиса (M1)
brew "pre-commit"        # проверки перед коммитом
brew "shellcheck"        # линтер shell-скриптов
brew "hadolint"          # линтер Dockerfile
brew "yq"                # YAML в терминале
brew "jq"                # JSON в терминале
brew "k6"                # нагрузочные тесты (M3, M5)
brew "kubeseal"          # Sealed Secrets (M4)
